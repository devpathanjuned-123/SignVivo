# --- Supabase ---------------------------------------------------------
# From your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Server-only. Never expose this to the browser.
# Used by signer routes (anonymous signers) and PDF finalize background jobs.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# --- Resend (transactional email) -----------------------------------
# Supabase Auth handles magic-link delivery for sign-in. Resend handles
# our "sign request" and "completion" notifications to signers + senders.
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="SignVivo <noreply@yourdomain.com>"

# --- App ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
